# 이 파일을 .env.local로 복사하고 값을 채우세요. (.env.local은 git에 올라가지 않아요)
#   cp .env.example .env.local

# OpenAI API 키 — https://platform.openai.com/api-keys 에서 발급 (선불 크레딧 필요)
# 이미지 생성(GPT Image)은 OpenAI 조직 인증(Organization Verification)을 마쳐야 쓸 수 있어요.
# 비워 두면 모든 AI 기능이 목업으로 동작해요.
OPENAI_API_KEY=

# (선택) 사진 분석·코디 추천 모델. 기본값 gpt-6.2-sol
# OPENAI_TEXT_MODEL=gpt-6.2-sol

# (선택) 상품 사진·아바타 착장 이미지 모델. 기본값 gpt-image-2.6-flare
# OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# (선택) 이미지 품질 low | medium | high. 기본값 medium (장당 약 $0.05, high는 약 $0.2)
# OPENAI_IMAGE_QUALITY=medium

# (선택) mock으로 두면 키가 있어도 목업으로 동작해요 (요금 없이 화면만 확인할 때)
# AI_MODE=mock
