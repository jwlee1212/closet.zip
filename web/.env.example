# 이 파일을 .env.local로 복사하고 값을 채우세요. (.env.local은 git에 올라가지 않아요)
#   cp .env.example .env.local

# Gemini API 키 — https://aistudio.google.com/apikey 에서 무료 발급 (카드 등록 불필요)
# 비워 두면 /api/analyze가 목업 분석으로 동작해요.
GEMINI_API_KEY=

# (선택) 분석 모델. 기본값 gemini-3.5-flash-lite (무료 한도가 넉넉함)
#   정확도가 더 필요하면 gemini-3.8-flash (무료 하루 한도가 더 적음)
# GEMINI_MODEL=gemini-3.5-flash-lite

# (선택) mock으로 두면 키가 있어도 목업 분석을 써요
# AI_ANALYZE_MODE=mock
